APP_NAME=Dashboard
APP_ENV=local
APP_KEY=
# MUST be false in production. Stack traces leak paths, queries and environment values.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
# Use warning or higher in production.
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# # DB_HOST=127.0.0.1
# # DB_PORT=3306
# # DB_DATABASE=laravel
# # DB_USERNAME=root
# # DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Requires HTTPS. With APP_URL=http://localhost some browsers (notably Safari) will not
# send Secure cookies over plain HTTP, which causes login loops. Use Herd or Valet with
# HTTPS (https://dashboard.test) locally, or set this to false in your own .env only.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000,dashboard.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Keep both false in production.
LARADOCS_ENABLED=false
LARADOCS_ROUTE_REGISTER=false

# Set to false wherever the log viewer is not needed.
LOG_VIEWER_ENABLED=true

STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxx
# Mandatory outside local and testing. A blank value means webhooks are not verified.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
CASHIER_CURRENCY=gbp
CASHIER_CURRENCY_LOCALE=en_GB

# Explicit origins only, never *. Production origins must be HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1:8000,http://dashboard.test

# Local-only override for spatie/laravel-backup - the directory containing
# the mysqldump binary. Leave empty in production if mysqldump is already
# on PATH. On macOS/Homebrew, find yours with `which mysqldump` and use the
# containing directory, e.g. /opt/homebrew/opt/mysql@8.0/bin/
MYSQLDUMP_PATH=

# Off-site backups (spatie/laravel-backup). The disk must not be on the app server.
BACKUP_DISK=s3
BACKUP_NOTIFICATION_EMAIL=
# Archive encryption password. Run php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
BACKUP_ARCHIVE_PASSWORD=

# Run php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# Required outside local and testing. The application refuses to boot without it.
AUDIT_LOG_HMAC_KEY=
AUDIT_LOG_HMAC_KEY_ID=v1
# JSON map of retired key ids to keys, so older signatures still verify after rotation.
# AUDIT_LOG_HMAC_RETIRED_KEYS='{"v1":"replace-with-the-old-key"}'