parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$likeable of method App\\Services\\Likes\\DeleterService\:\:delete\(\) expects App\\Contracts\\Likeable&Illuminate\\Database\\Eloquent\\Model, App\\Models\\Comment given\.$#'
			identifier: argument.type
			count: 1
			path: app/Actions/Like/UnlikeComment.php

		-
			message: '#^Parameter \#1 \$likeable of method App\\Services\\Likes\\DeleterService\:\:delete\(\) expects App\\Contracts\\Likeable&Illuminate\\Database\\Eloquent\\Model, App\\Models\\Post given\.$#'
			identifier: argument.type
			count: 1
			path: app/Actions/Like/UnlikePost.php

		-
			message: '#^Call to method getById\(\) on an unknown class App\\Services\\Pipelines\\QueryService\.$#'
			identifier: class.notFound
			count: 2
			path: app/Http/Controllers/PipelineController.php

		-
			message: '#^Call to method getCreateData\(\) on an unknown class App\\Services\\Pipelines\\QueryService\.$#'
			identifier: class.notFound
			count: 1
			path: app/Http/Controllers/PipelineController.php

		-
			message: '#^Call to method getPaginated\(\) on an unknown class App\\Services\\Pipelines\\QueryService\.$#'
			identifier: class.notFound
			count: 1
			path: app/Http/Controllers/PipelineController.php

		-
			message: '#^Parameter \$query of method App\\Http\\Controllers\\PipelineController\:\:__construct\(\) has invalid type App\\Services\\Pipelines\\QueryService\.$#'
			identifier: class.notFound
			count: 1
			path: app/Http/Controllers/PipelineController.php

		-
			message: '#^Property App\\Http\\Controllers\\PipelineController\:\:\$query has unknown class App\\Services\\Pipelines\\QueryService as its type\.$#'
			identifier: class.notFound
			count: 1
			path: app/Http/Controllers/PipelineController.php

		-
			message: '#^Using nullsafe method call on non\-nullable type Carbon\\CarbonImmutable\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: app/Services/Payments/ExporterService.php

		-
			message: '#^Using nullsafe property access on non\-nullable type App\\Models\\Invoice\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Services/Payments/ExporterService.php

		-
			message: '#^Using nullsafe property access on non\-nullable type App\\Models\\PaymentStatus\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Services/Payments/ExporterService.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: app/Services/Plans/QueryService.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(Illuminate\\Database\\Eloquent\\Model\)\: mixed\)\|null, Closure\(App\\Models\\Plan\)\: array\<string, mixed\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Services/Plans/QueryService.php

		-
			message: '#^Trait App\\Traits\\Commentable is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: app/Traits/Commentable.php

