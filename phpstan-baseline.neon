			identifier: nullsafe.neverNull
			count: 1
			path: app/Services/Payments/ExporterService.php

		-
			message: '#^Method App\\Services\\Plans\\DataPreparationService\:\:prepareForCreation\(\) invoked with 2 parameters, 1 required\.$#'
			identifier: arguments.count
			count: 1
			path: app/Services/Plans/CreatorService.php

		-
			message: '#^Negated boolean expression is always false\.$#'
